{
  "name": "@vidplate/react",
  "version": "0.1.0",
  "description": "VidPlate-styled template picker and schema-driven order form for React.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./assets/fonts.css"
  },
  "files": ["dist", "src/styles.css", "assets", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "engines": { "node": ">=20" },
  "peerDependencies": { "react": ">=18 <20", "react-dom": ">=18 <20" },
  "dependencies": { "ajv": "8.20.0", "ajv-formats": "3.0.1" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/react": "^18.3.0", "@types/react-dom": "^18.3.0", "typescript": "^5.8.0", "react": "18.3.1", "react-dom": "18.3.1" },
  "scripts": { "build": "tsc -p tsconfig.json", "test": "npm run build && node --test test/*.test.mjs", "prepack": "npm run build" }
}
