# Server only. Never use NEXT_PUBLIC_ for these values.
VIDPLATE_API_KEY=
# A single-account example login. Set both before running; otherwise access is denied.
ORDER_DEMO_USERNAME=
ORDER_DEMO_PASSWORD=
# Optional comma-separated tpl_ IDs. Omit to expose the templates this key can read.
ORDER_ALLOWED_TEMPLATE_IDS=
# Optional only when the public origin differs from the origin Next receives.
ORDER_PUBLIC_ORIGIN=
